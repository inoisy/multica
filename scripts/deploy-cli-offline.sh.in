#!/usr/bin/env bash
# Generated by build-offline-cli-installer.py; the payload is pinned by SHA256.
set -euo pipefail
umask 077

EXPECTED_SHA256='@PAYLOAD_SHA256@'
EXPECTED_COMMIT='@EXPECTED_COMMIT@'
target=/usr/local/bin/multica
check_only=0
rollback_dir=
staging=
backup=
switched=0
committed=0
self=$(readlink -f -- "${BASH_SOURCE[0]}")

say() { printf '%s\n' "$*"; }
fail() { say "ОШИБКА: $*" >&2; exit 1; }
sha_of() {
  local line
  line=$(sha256sum -- "$1") || return 1
  printf '%s\n' "${line%% *}"
}

usage() {
  cat <<'USAGE'
Установка CLI с поддержкой Workflows (Linux amd64).
  bash deploy-multica-workflows-cli.sh
  bash deploy-multica-workflows-cli.sh --check
  bash deploy-multica-workflows-cli.sh --rollback <каталог-копии>
  bash deploy-multica-workflows-cli.sh --target /absolute/path/multica

По умолчанию: /usr/local/bin/multica (нужны права root).
--check проверяет встроенный бинарь без замены и резервной копии.
Сервер, демон, раны и настройки доступа скрипт не перезапускает и не меняет.
USAGE
}

check_candidate() {
  local file=$1 version
  version=$(timeout 15s "$file" --version) || return 1
  [[ "$version" == *"commit: ${EXPECTED_COMMIT:0:9},"* ]] || {
    say "Не совпадает версия встроенного CLI: $version" >&2
    return 1
  }
  timeout 15s "$file" workflow --help >/dev/null || return 1
  timeout 15s "$file" project workflow --help >/dev/null || return 1
  say "$version"
}

# Used both explicitly and by the EXIT trap after a failed activation.
# Commands return errors explicitly because callers may use an if condition.
restore_backup() {
  local dir=$1 recorded_target recorded_sha current_sha
  [[ -f "$dir/target" && ! -L "$dir/target" && -f "$dir/sha256" && ! -L "$dir/sha256" && -f "$dir/multica" && ! -L "$dir/multica" ]] || return 1
  IFS= read -r recorded_target < "$dir/target" || return 1
  IFS= read -r recorded_sha < "$dir/sha256" || return 1
  [[ "$recorded_target" == "$target" && "$recorded_sha" =~ ^[0-9a-f]{64}$ ]] || return 1
  [[ "$(sha_of "$dir/multica")" == "$recorded_sha" ]] || return 1
  [[ ! -L "$target" ]] || return 1
  if [[ -e "$target" ]]; then
    [[ -f "$target" ]] || return 1
    current_sha=$(sha_of "$target") || return 1
    if [[ "$current_sha" == "$recorded_sha" ]]; then
      say 'Предыдущий CLI уже восстановлен.'
      return 0
    fi
    [[ "$current_sha" == "$EXPECTED_SHA256" ]] || {
      say 'Текущий CLI изменён после этой выкатки; откат остановлен.' >&2
      return 1
    }
  fi
  cp -p -- "$dir/multica" "$staging/restore" || return 1
  mv -fT -- "$staging/restore" "$target" || return 1
  [[ "$(sha_of "$target")" == "$recorded_sha" ]] || return 1
  say "Восстановлен предыдущий CLI: $target"
}

cleanup() {
  local rc=$?
  trap - EXIT HUP INT TERM
  set +e
  if (( switched && ! committed )); then
    say 'Проверка после замены не завершилась успешно; откатываю CLI.' >&2
    if [[ -n "$backup" ]]; then
      if ! restore_backup "$backup"; then
        say "ОШИБКА ОТКАТА: резервная копия сохранена в $backup" >&2
        rc=1
      fi
    elif [[ -f "$target" && ! -L "$target" && "$(sha_of "$target")" == "$EXPECTED_SHA256" ]]; then
      rm -f -- "$target" || rc=1
    else
      say 'Целевой файл изменён другим процессом; оставляю его для проверки.' >&2
      rc=1
    fi
  fi
  if [[ -n "$staging" ]]; then rm -rf -- "$staging"; fi
  exit "$rc"
}

main() {
  while (( $# )); do
    case "$1" in
      --check) check_only=1; shift ;;
      --target) [[ $# -ge 2 && -n "$2" ]] || fail 'Для --target нужен путь'; target=$2; shift 2 ;;
      --rollback) [[ $# -ge 2 && -n "$2" ]] || fail 'Для --rollback нужен каталог копии'; rollback_dir=$2; shift 2 ;;
      -h|--help) usage; return ;;
      *) fail "Неизвестный аргумент: $1" ;;
    esac
  done
  (( ! check_only )) || [[ -z "$rollback_dir" ]] || fail '--check и --rollback несовместимы'
  [[ "$(uname -s)" == Linux && "$(uname -m)" == x86_64 ]] || fail 'Нужен Linux x86_64; встроен бинарь amd64'
  local command parent name backup_root original_sha
  for command in awk base64 gzip sha256sum timeout flock mktemp cp mv chmod date mkdir rm; do
    command -v "$command" >/dev/null || fail "Не найдена команда $command"
  done
  [[ "$target" == /* && "$target" != *$'\n'* ]] || fail 'Целевой путь должен быть абсолютным, без перевода строки'
  name=${target##*/}
  [[ -n "$name" && "$name" != . && "$name" != .. ]] || fail 'Некорректное имя целевого файла'
  parent=$(cd -P -- "${target%/*}" && pwd) || fail 'Каталог установки не существует'
  target=$parent/$name
  [[ ! -L "$target" && ( ! -e "$target" || -f "$target" ) ]] || fail 'Целевой путь должен быть обычным файлом, не ссылкой'
  backup_root=$parent/.multica-cli-backups
  trap cleanup EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  trap 'exit 129' HUP

  if (( check_only )); then
    staging=$(mktemp -d "${TMPDIR:-/tmp}/multica-cli-check.XXXXXXXX")
  else
    [[ -w "$parent" ]] || fail "Нет прав записи в $parent; запустите от root"
    [[ ! -L "$parent/.multica-cli-deploy.lock" ]] || fail 'Файл блокировки не должен быть ссылкой'
    exec 9>"$parent/.multica-cli-deploy.lock"
    flock -n 9 || fail 'Другая установка CLI уже идёт'
    staging=$(mktemp -d "$parent/.multica-cli-deploy.XXXXXXXX")
  fi

  if [[ -n "$rollback_dir" ]]; then
    [[ ! -L "$backup_root" && -d "$backup_root" ]] || fail 'Не найден каталог резервных копий'
    rollback_dir=$(cd -P -- "$rollback_dir" && pwd) || fail 'Не найден каталог копии'
    [[ "$rollback_dir" == "$backup_root/"* ]] || fail "Копия должна находиться в $backup_root"
    restore_backup "$rollback_dir" || fail 'Не удалось проверить или восстановить копию'
    timeout 15s "$target" --version
    return
  fi

  say "1/4 Проверяю встроенную сборку $EXPECTED_COMMIT"
  awk 'found {print} /^__MULTICA_CLI_PAYLOAD__$/ {found=1}' "$self" | base64 --decode | gzip -d > "$staging/candidate"
  [[ "$(sha_of "$staging/candidate")" == "$EXPECTED_SHA256" ]] || fail 'SHA256 встроенного бинаря не совпадает'
  chmod 755 "$staging/candidate"
  check_candidate "$staging/candidate" || fail 'Встроенный CLI не прошёл проверку'
  if (( check_only )); then
    say 'Проверка пройдена. Установка не выполнялась.'
    return
  fi
  if [[ -f "$target" && "$(sha_of "$target")" == "$EXPECTED_SHA256" ]]; then
    check_candidate "$target" || fail 'Установленный CLI не прошёл проверку'
    say 'Эта сборка уже установлена; новая копия не создаётся.'
    return
  fi

  say '2/4 Сохраняю предыдущий CLI'
  if [[ -e "$target" ]]; then
    [[ ! -L "$backup_root" && ( ! -e "$backup_root" || -d "$backup_root" ) ]] || fail 'Некорректный каталог резервных копий'
    mkdir -p -- "$backup_root"
    chmod 700 "$backup_root"
    backup=$(mktemp -d "$backup_root/$(date -u +%Y%m%dT%H%M%SZ).XXXXXXXX")
    original_sha=$(sha_of "$target")
    cp -a -- "$target" "$backup/multica"
    [[ "$(sha_of "$backup/multica")" == "$original_sha" ]] || fail 'Не удалось проверить резервную копию'
    printf '%s\n' "$original_sha" > "$backup/sha256"
    printf '%s\n' "$target" > "$backup/target"
    say "Резервная копия: $backup"
    printf 'Ручной откат: bash %q --target %q --rollback %q\n' "$self" "$target" "$backup"
    [[ "$(sha_of "$target")" == "$original_sha" ]] || fail 'CLI изменён другим процессом во время подготовки'
  fi

  say "3/4 Атомарно заменяю $target"
  # Rename stays on the target filesystem; running daemon processes retain
  # their old executable inode. No process is stopped or restarted here.
  switched=1
  mv -fT -- "$staging/candidate" "$target"
  say '4/4 Проверяю установленный CLI'
  [[ "$(sha_of "$target")" == "$EXPECTED_SHA256" ]] || fail 'SHA256 после установки не совпадает'
  check_candidate "$target" || fail 'Установленный CLI не прошёл проверку'
  committed=1
  say 'Готово. CLI Workflows установлен. Демон и сервер не перезапускались.'
}

main "$@"
exit 0
__MULTICA_CLI_PAYLOAD__
